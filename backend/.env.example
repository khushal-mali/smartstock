# Database Connection (use Neon / Supabase / Railway PostgreSQL URL in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartstock_db?schema=public"

# JWT Secret Key (use a long random string in production)
JWT_SECRET="smartstock_jwt_secret_key_college_project_2026"

# Port (Vercel ignores this — it manages its own port)
PORT=5000

# Allowed frontend origin(s), comma-separated (set to your Vercel frontend URL in production)
# e.g. FRONTEND_URL="https://smartstock-frontend.vercel.app"
FRONTEND_URL="http://localhost:3000"

